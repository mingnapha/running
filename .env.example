# คัดลอกเป็น .dev.vars (ห้าม commit) — ใช้ตอน `npm run dev` และ `npm run cf:preview`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key จาก `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key จาก `supabase status`>
# คีย์ทดสอบของ Turnstile (ผ่านเสมอ) — ใช้ตอนพัฒนาเท่านั้น
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
LOGIN_HASH_SALT=change-me-to-a-long-random-string
AUTH_EMAIL_DOMAIN=users.workingrun.internal
